def round_up_strike(price, base=10):
    """Round UP to next strike (for high PE) - SBIN uses 10 rupee strikes"""
    return int(math.ceil(price / base) * base)


def round_down_strike(price, base=10):
    """Round DOWN to previous strike (for low CE) - SBIN uses 10 rupee strikes"""
    return int(math.floor(price / base) * base)


def build_sbin_option_symbol(expiry_date, strike, option_type):
    """
    Build Fyers option symbol for SBIN monthly options
    Format: NSE:SBIN[YY][MMM][STRIKE][CE/PE]
    Example: NSE:SBIN25OCT850CE for Oct 2025, 850 CE
    
    Monthly options use 3-letter month code (JAN, FEB, MAR, etc.)
    """
    expiry_dt = datetime.strptime(expiry_date, "%Y-%m-%d")
    
    year = expiry_dt.strftime("%y")  # Last 2 digits: 25
    month = expiry_dt.strftime("%b").upper()  # 3-letter month: OCT, NOV, etc.
    
    symbol = f"NSE:SBIN{year}{month}{strike}{option_type}"
    return symbol

def data_option_chain_v3(access_token: str, underlying_symbol: str, expiry: Optional[str] = None) -> dict:
    """Fetch option chain using Data API v3 for an underlying.
    underlying_symbol examples: 'NSE:SBIN-EQ'
    expiry (optional): 'YYYY-MM-DD' to filter a specific series.
    """
    if not REQUESTS_AVAILABLE:
        raise RuntimeError("The 'requests' package is required. Install with: pip install requests")
    base = _infer_data_base_url_from_client_id(client_id)
    url = f"{base}/options-chain-v3"
    headers = {"Authorization": f"Bearer {access_token}", "Content-Type": "application/json"}
    payload = {"symbol": underlying_symbol}
    if expiry:
        payload["expiry"] = expiry
    resp = requests.post(url, headers=headers, data=json.dumps(payload), timeout=30)
    try:
        return resp.json()
    except Exception:
        return {"status_code": resp.status_code, "text": resp.text}


def get_stock_high_low(fyers, symbol, from_date, to_date):
    """Get stock high and low for a date range"""
    print("\n" + "="*80)
    print(f"FETCHING {symbol} HIGH/LOW DATA")
    print("="*80)
    print(f"Period: {from_date} to {to_date}\n")
    
    data = {
        "symbol": symbol,
        "resolution": "D",
        "date_format": "1",
        "range_from": from_date,
        "range_to": to_date,
        "cont_flag": "1"
    }
    
    response = fyers.history(data)
    
    if response.get('code') != 200:
        print(f"✗ Error: {response}")
        return None
    
    candles = response.get('candles', [])
    
    if not candles:
        print("✗ No data available for this period")
        return None
    
    print(f"✓ Fetched {len(candles)} days of data\n")
    
    highs = [candle[2] for candle in candles]
    lows = [candle[3] for candle in candles]
    closes = [candle[4] for candle in candles]
    
    highest_price = max(highs)
    lowest_price = min(lows)
    
    highest_candle = candles[highs.index(highest_price)]
    lowest_candle = candles[lows.index(lowest_price)]
    
    highest_date = datetime.fromtimestamp(highest_candle[0]).strftime('%Y-%m-%d')
    lowest_date = datetime.fromtimestamp(lowest_candle[0]).strftime('%Y-%m-%d')
    
    first_candle = candles[0]
    last_candle = candles[-1]
    
    first_date = datetime.fromtimestamp(first_candle[0]).strftime('%Y-%m-%d')
    last_date = datetime.fromtimestamp(last_candle[0]).strftime('%Y-%m-%d')
    
    first_close = first_candle[4]
    last_close = last_candle[4]
    
    change = last_close - first_close
    change_pct = (change / first_close) * 100
    
    stats = {
        'symbol': symbol,
        'period_start': first_date,
        'period_end': last_date,
        'trading_days': len(candles),
        'highest_price': highest_price,
        'highest_date': highest_date,
        'lowest_price': lowest_price,
        'lowest_date': lowest_date,
        'range': highest_price - lowest_price,
        'first_close': first_close,
        'last_close': last_close,
        'change': change,
        'change_percent': change_pct,
        'average_close': sum(closes) / len(closes),
        'candles': candles
    }
    
    print("="*80)
    print(f"{symbol} STATISTICS")
    print("="*80)
    print(f"Period:          {first_date} to {last_date}")
    print(f"Trading Days:    {stats['trading_days']}")
    print(f"\n{'HIGHEST':-^80}")
    print(f"Price:           ₹{highest_price:,.2f}")
    print(f"Date:            {highest_date}")
    print(f"\n{'LOWEST':-^80}")
    print(f"Price:           ₹{lowest_price:,.2f}")
    print(f"Date:            {lowest_date}")
    print(f"\n{'RANGE & MOVEMENT':-^80}")
    print(f"Range:           ₹{stats['range']:,.2f} ({(stats['range']/lowest_price)*100:.2f}%)")
    print(f"Opening:         ₹{first_close:,.2f} ({first_date})")
    print(f"Closing:         ₹{last_close:,.2f} ({last_date})")
    print(f"Net Change:      ₹{change:+,.2f} ({change_pct:+.2f}%)")
    print(f"Average Close:   ₹{stats['average_close']:,.2f}")
    print("="*80)
    
    return stats


def get_option_historical_data(fyers, option_symbol, from_date, to_date, resolution="15"):
    """Fetch historical data for an option"""
    
    data = {
        "symbol": option_symbol,
        "resolution": resolution,
        "date_format": "1",
        "range_from": from_date,
        "range_to": to_date,
        "cont_flag": "1"
    }
    
    print(f"   DEBUG - Request: {data}")
    response = fyers.history(data)
    print(f"   DEBUG - Response Code: {response.get('code')}, Message: {response.get('message', 'N/A')}")
    
    # If SDK path fails (e.g., -300 invalid symbol), try Data API directly
    if response.get('code') == 200:
        return response.get('candles', [])
    
    print("   INFO - Falling back to Data API /history...")
    token = get_access_token_from_env_or_file()
    if not token:
        print("   WARN - No access token available for Data API fallback. Set FYERS_ACCESS_TOKEN or create fyers_token.txt")
        return None
    try:
        # Validate symbol quickly via /data/quotes
        q = data_quotes_via_requests(token, option_symbol)
        if isinstance(q, dict) and q.get('code') == -300:
            print("   HINT - Invalid symbol. For monthly options use 3-letter month code (e.g., SEP, OCT). For weekly options use 1..9,O,N,D plus day.")
        # Fetch history via Data API
        h = data_history_via_requests(token, option_symbol, from_date, to_date, resolution=resolution, date_format=1)
        print(f"   DEBUG - Data API status: {h.get('code', h.get('s', 'N/A'))}, Message: {h.get('message', h.get('msg', ''))}")
        if h.get('code') == 200 or h.get('s') == 'ok':
            return h.get('candles', [])
        return None
    except Exception as e:
        print(f"   ERROR - Data API fallback failed: {e}")
        return None

def _infer_data_base_url_from_client_id(cid: str) -> str:
    return "https://api-t1.fyers.in/data" if cid.endswith("-100") else "https://api.fyers.in/data"

def _to_epoch(date_str: str) -> int:
    dt = datetime.strptime(date_str, "%Y-%m-%d").replace(tzinfo=timezone.utc)
    return int(dt.timestamp())

def get_access_token_from_env_or_file() -> str | None:
    token = os.environ.get("FYERS_ACCESS_TOKEN")
    if token:
        return token.strip()
    try:
        with open('fyers_token.txt', 'r') as f:
            return f.read().strip()
    except FileNotFoundError:
        return None

def data_history_via_requests(access_token: str, symbol: str, range_from: str, range_to: str, resolution: str = "15", date_format: int = 1, cont_flag: str = "1") -> dict:
    if not REQUESTS_AVAILABLE:
        raise RuntimeError("The 'requests' package is required. Install with: pip install requests")
    base = _infer_data_base_url_from_client_id(client_id)
    url = f"{base}/history"
    payload: dict[str, object] = {
        "symbol": symbol,
        "resolution": resolution,
        "date_format": date_format,
        "cont_flag": cont_flag,
    }
    if date_format == 1:
        payload.update({"range_from": range_from, "range_to": range_to})
    else:
        payload.update({"range_from": _to_epoch(range_from), "range_to": _to_epoch(range_to)})
    headers = {"Authorization": f"Bearer {access_token}", "Content-Type": "application/json"}
    resp = requests.post(url, headers=headers, data=json.dumps(payload), timeout=30)
    try:
        return resp.json()
    except Exception:
        return {"status_code": resp.status_code, "text": resp.text}

def data_quotes_via_requests(access_token: str, symbol: str) -> dict:
    if not REQUESTS_AVAILABLE:
        raise RuntimeError("The 'requests' package is required. Install with: pip install requests")
    base = _infer_data_base_url_from_client_id(client_id)
    url = f"{base}/quotes"
    headers = {"Authorization": f"Bearer {access_token}", "Content-Type": "application/json"}
    payload = {"symbols": symbol}
    resp = requests.post(url, headers=headers, data=json.dumps(payload), timeout=15)
    try:
        return resp.json()
    except Exception:
        return {"status_code": resp.status_code, "text": resp.text}


def analyze_options_based_on_stock_range(fyers, stock_stats, expiry_date, from_date, to_date):
    """
    Based on stock high/low:
    - High: Round UP to next 10 → Select PE
    - Low: Round DOWN to previous 10 → Select CE
    - Fetch historical data for these options
    """
    print("\n" + "="*80)
    print("ANALYZING OPTIONS BASED ON STOCK RANGE")
    print("="*80)
    
    high = stock_stats['highest_price']
    low = stock_stats['lowest_price']
    
    # Round UP high for PE, Round DOWN low for CE (₹10 strikes for SBIN)
    high_strike = round_up_strike(high, 10)
    low_strike = round_down_strike(low, 10)
    
    print(f"\nStock High: ₹{high:,.2f} → ROUND UP → Strike: {high_strike}")
    print(f"Stock Low:  ₹{low:,.2f} → ROUND DOWN → Strike: {low_strike}")
    
    print(f"\nSelected Strikes:")
    print(f"  • High Strike PE: {high_strike}PE")
    print(f"  • Low Strike CE:  {low_strike}CE")
    
    # Build option symbols for SBIN monthly options (initial attempt)
    high_pe_symbol = build_sbin_option_symbol(expiry_date, high_strike, "PE")
    low_ce_symbol = build_sbin_option_symbol(expiry_date, low_strike, "CE")

    # Validate/adjust via Option Chain if SDK history returns -300 later
    token = get_access_token_from_env_or_file()
    chain_symbols = {"PE": high_pe_symbol, "CE": low_ce_symbol}
    if token:
        try:
            chain = data_option_chain_v3(token, "NSE:SBIN-EQ", expiry=expiry_date)
            # Chain format: expect a list of entries with 'strike_price', 'call_symbol', 'put_symbol' or similar
            entries = chain.get("data") or chain.get("optionChain") or []
            if isinstance(entries, dict) and "options" in entries:
                entries = entries["options"]
            # Find nearest available strikes
            def nearest_symbol(strike: int, typ: str) -> str | None:
                best = None
                best_diff = 10**9
                for item in entries:
                    sp = item.get("strike_price") or item.get("strikePrice") or item.get("strike")
                    if sp is None:
                        continue
                    try:
                        sp_i = int(float(sp))
                    except Exception:
                        continue
                    diff = abs(sp_i - strike)
                    if diff < best_diff:
                        # symbol fields vary; try common keys
                        sym = None
                        if typ == "CE":
                            sym = item.get("call_symbol") or item.get("CE_symbol") or item.get("callSymbol") or item.get("symbolCE")
                        else:
                            sym = item.get("put_symbol") or item.get("PE_symbol") or item.get("putSymbol") or item.get("symbolPE")
                        if sym:
                            best = sym
                            best_diff = diff
                return best
            ce_sym = nearest_symbol(low_strike, "CE")
            pe_sym = nearest_symbol(high_strike, "PE")
            if ce_sym:
                low_ce_symbol = ce_sym
            if pe_sym:
                high_pe_symbol = pe_sym
        except Exception as e:
            print(f"   WARN - Option chain lookup failed: {e}")
    
    print(f"\n{'='*80}")
    print("BUILT OPTION SYMBOLS")
    print(f"{'='*80}")
