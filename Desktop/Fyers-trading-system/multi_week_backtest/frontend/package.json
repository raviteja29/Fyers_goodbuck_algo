{
  "name": "fyers-trading-frontend",
  "version": "1.0.0",
  "description": "Frontend for Fyers multi-week backtesting trading system",
  "private": true,
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.15.0",
    "axios": "^1.5.0",
    "recharts": "^2.8.0",
